{
  "appId": "fr.fuelnode.app",
  "appName": "FuelNode",
  "webDir": "dist",
  "android": {
    "adjustMarginsForEdgeToEdge": "force"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0a0e1a"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0a0e1a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0e1a",
      "overlaysWebView": false
    }
  }
}
